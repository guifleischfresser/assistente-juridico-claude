{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "português do Brasil",
  "effortLevel": "medium",
  "theme": "dark",
  "outputStyle": "Advogado",
  "model": "claude-opus-5-5",
  "modelSettings": { "claude-opus-5-5": { "effortLevel": "medium" } },
  "autoMemoryEnabled": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit({{ESCRITORIO_REGRA}}/**)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/_anonimizacao/**)"
    ],
    "additionalDirectories": [
      "{{ESCRITORIO}}",
      "{{BASE}}"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/sessao-inicio.js"], "timeout": 20, "statusMessage": "Preparando o escritório..." }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/registro-pedidos.js"], "timeout": 10 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/guarda-escrita.js"], "timeout": 15 }
      ] },
      { "matcher": "^(Bash|PowerShell|WebFetch|WebSearch|Read|NotebookRead|Grep|mcp__.*)$", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/guarda-sigilo.js"], "timeout": 10 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/pos-ferramenta.js"], "timeout": 20 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/memoria.js", "reflexao", "--automatica", "--fim"], "timeout": 30 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/gatilho-handoff.js"], "timeout": 30 }
      ] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"{{BASE}}/scripts/statusline.js\"",
    "padding": 0
  }
}

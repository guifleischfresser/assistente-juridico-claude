{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "português do Brasil",
  "effortLevel": "medium",
  "theme": "dark",
  "outputStyle": "Advogado",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit({{ESCRITORIO_REGRA}}/**)",
      "Bash(node *advogado/scripts/*)",
      "PowerShell(node *advogado/scripts/*)"
    ],
    "ask": [
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)"
    ],
    "additionalDirectories": [
      "{{ESCRITORIO}}",
      "{{BASE}}"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/sessao-inicio.js"], "timeout": 20, "statusMessage": "Preparando o escritório..." }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/registro-pedidos.js"], "timeout": 10 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/guarda-escrita.js"], "timeout": 15 }
      ] },
      { "matcher": "^(Bash|PowerShell|WebFetch|WebSearch|mcp__.*)$", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/guarda-sigilo.js"], "timeout": 10 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/pos-ferramenta.js"], "timeout": 20 }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["{{BASE}}/scripts/gatilho-handoff.js"], "timeout": 10 }
      ] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"{{BASE}}/scripts/statusline.js\"",
    "padding": 0
  }
}
